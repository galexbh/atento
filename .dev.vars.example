# Copia este archivo a .dev.vars (ignorado por git) para desarrollo local.
# Clave secreta de Cloudflare Turnstile. Para pruebas locales puede usarse la clave de prueba
# "1x0000000000000000000000000000000AA" (siempre pasa). Solo se acepta con ENTORNO=local.
TURNSTILE_SECRET=

# Entorno: "local" relaja Origin, Turnstile y la cookie Secure. En preview/producción lo fija
# wrangler.jsonc (no lo pongas aquí si quieres probar el comportamiento de producción).
ENTORNO=local

# Sal secreta del hash de IP (límite de tasa de /api/respuesta e intentos de /admin/entrar).
# Obligatoria en producción (`wrangler secret put RATE_SALT`): sin ella /api/respuesta responde 503.
# Genera una cadena aleatoria larga, p. ej. `openssl rand -hex 32`.
RATE_SALT=

# --- Panel de administración (/admin) ---
# "access" (Cloudflare Access, por defecto) o "password" (respaldo con contraseña única).
ADMIN_MODO=password
# Hash generado con: pnpm tsx scripts/hash-password.ts "tu contraseña" (PBKDF2, 100 000 iteraciones:
# Cloudflare Workers no admite más).
ADMIN_PASSWORD_HASH=
# Cadena aleatoria larga para firmar la cookie de sesión y seudonimizar ids en microdatos.
# Obligatoria en producción (503 si falta); en local, si falta, se deriva del hash.
ADMIN_SESSION_SECRET=
# Solo en modo access:
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAILS=
INVESTIGADOR_EMAILS=
