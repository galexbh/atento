---
/**
 * Gráfico de barras SVG accesible (horizontal por defecto; vertical para histogramas).
 * Las barras suprimidas (n < 5) se dibujan con trama gris y la etiqueta "n < 5".
 */
import Tabla from "./Tabla.astro";

export interface DatoBarra {
  etiqueta: string;
  valor: number | null;
  suprimido?: boolean;
  /** Texto del tooltip/tabla (p. ej. "12,3 % (IC95 ...)"). */
  detalle?: string;
}

interface Props {
  titulo: string;
  datos: DatoBarra[];
  unidad?: string;
  max?: number;
  orientacion?: "horizontal" | "vertical";
  /** Nombre de la columna de valor en la tabla de datos. */
  nombreValor?: string;
  id?: string;
}
const {
  titulo,
  datos,
  unidad = "",
  max: maxProp,
  orientacion = "horizontal",
  nombreValor = "Valor",
  id = `barras-${Math.random().toString(36).slice(2, 8)}`,
} = Astro.props;

const valores = datos.map((d) => d.valor ?? 0);
const max = maxProp ?? Math.max(1, ...valores);
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => t * max);
const fmt = (v: number) => `${Number.isInteger(v) ? v : v.toFixed(1)}${unidad}`;

const ancho = 640;
const margenIzq = orientacion === "horizontal" ? 150 : 40;
const margenDer = 60;
const filaAlto = 26;
const alto = orientacion === "horizontal" ? datos.length * filaAlto + 40 : 240;
const areaAncho = ancho - margenIzq - margenDer;
const areaAlto = alto - 50;
const escala = (v: number) => (max === 0 ? 0 : v / max);
const anchoBarraV = datos.length ? Math.max(4, areaAncho / datos.length - 2) : 0;
const filasTabla = datos.map((d) => ({
  etiqueta: d.etiqueta,
  valor: d.suprimido ? "n < 5" : d.valor === null ? "—" : (d.detalle ?? fmt(d.valor)),
}));
---

<figure class="grafico">
  <figcaption id={`${id}-t`}>{titulo}</figcaption>
  {datos.length === 0 ? (
    <p class="panel__nota">Sin datos para los filtros elegidos.</p>
  ) : (
    <svg class="viz" viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-labelledby={`${id}-t`} aria-describedby={`${id}-d`}>
      <desc id={`${id}-d`}>{datos.map((d) => `${d.etiqueta}: ${d.suprimido ? "n menor que 5" : d.valor === null ? "sin dato" : fmt(d.valor)}`).join("; ")}</desc>
      <defs>
        <pattern id={`${id}-trama`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--viz-trama)" stroke-width="1.5" />
        </pattern>
      </defs>
      {orientacion === "horizontal" ? (
        <g>
          {ticks.map((t) => (
            <g>
              <line class="viz__rejilla" x1={margenIzq + escala(t) * areaAncho} x2={margenIzq + escala(t) * areaAncho} y1={10} y2={alto - 30} />
              <text class="viz__eje-etq" x={margenIzq + escala(t) * areaAncho} y={alto - 14} text-anchor="middle">{fmt(t)}</text>
            </g>
          ))}
          <line class="viz__eje" x1={margenIzq} x2={margenIzq} y1={10} y2={alto - 30} />
          {datos.map((d, i) => {
            const y = 12 + i * filaAlto;
            const w = d.suprimido || d.valor === null ? 0 : escala(Math.max(0, d.valor)) * areaAncho;
            return (
              <g>
                <title>{d.etiqueta}: {d.suprimido ? "n < 5 (suprimido)" : d.valor === null ? "sin dato" : d.detalle ?? fmt(d.valor)}</title>
                <text x={margenIzq - 8} y={y + 14} text-anchor="end">{d.etiqueta.length > 22 ? `${d.etiqueta.slice(0, 21)}…` : d.etiqueta}</text>
                {d.suprimido ? (
                  <rect x={margenIzq} y={y + 2} width={areaAncho * 0.08} height={filaAlto - 8} fill={`url(#${id}-trama)`} stroke="var(--viz-trama)" stroke-width="1" rx="3" />
                ) : (
                  <rect x={margenIzq} y={y + 2} width={w} height={filaAlto - 8} fill="var(--viz-serie-1)" rx="3" />
                )}
                <text class="viz__eje-etq" x={margenIzq + (d.suprimido ? areaAncho * 0.08 : w) + 6} y={y + 14}>{d.suprimido ? "n < 5" : d.valor === null ? "—" : fmt(d.valor)}</text>
              </g>
            );
          })}
        </g>
      ) : (
        <g>
          {ticks.map((t) => (
            <g>
              <line class="viz__rejilla" x1={margenIzq} x2={ancho - margenDer} y1={10 + areaAlto - escala(t) * areaAlto} y2={10 + areaAlto - escala(t) * areaAlto} />
              <text class="viz__eje-etq" x={margenIzq - 6} y={14 + areaAlto - escala(t) * areaAlto} text-anchor="end">{fmt(t)}</text>
            </g>
          ))}
          <line class="viz__eje" x1={margenIzq} x2={ancho - margenDer} y1={10 + areaAlto} y2={10 + areaAlto} />
          {datos.map((d, i) => {
            const x = margenIzq + i * (areaAncho / datos.length) + 1;
            const h = d.suprimido || d.valor === null ? 0 : escala(Math.max(0, d.valor)) * areaAlto;
            return (
              <g>
                <title>{d.etiqueta}: {d.suprimido ? "n < 5 (suprimido)" : d.valor === null ? "sin dato" : d.detalle ?? fmt(d.valor)}</title>
                {d.suprimido ? (
                  <rect x={x} y={10 + areaAlto - 10} width={anchoBarraV} height={10} fill={`url(#${id}-trama)`} stroke="var(--viz-trama)" stroke-width="1" rx="3" />
                ) : (
                  <rect x={x} y={10 + areaAlto - h} width={anchoBarraV} height={h} fill="var(--viz-serie-1)" rx="3" />
                )}
                {datos.length <= 16 && (
                  <text class="viz__eje-etq" x={x + anchoBarraV / 2} y={alto - 16} text-anchor="middle">{d.etiqueta}</text>
                )}
              </g>
            );
          })}
        </g>
      )}
    </svg>
  )}
  <Tabla plegada columnas={[{ clave: "etiqueta", etiqueta: "Categoría" }, { clave: "valor", etiqueta: nombreValor, tipo: "num" }]} filas={filasTabla} />
</figure>

<style>
  .grafico {
    margin: 0;
  }
  .grafico figcaption {
    font-weight: 600;
    margin-bottom: var(--espacio-2);
  }
</style>
