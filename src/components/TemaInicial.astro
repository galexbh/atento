---
/** Aplica el tema guardado (atento:tema) antes del primer pintado para evitar parpadeo. */
const nonce = Astro.locals.nonce;
---

<script is:inline nonce={nonce}>
  try {
    var t = localStorage.getItem("atento:tema");
    if (t === "claro" || t === "oscuro") {
      document.documentElement.dataset.theme = t === "claro" ? "light" : "dark";
    }
  } catch (e) {}
</script>
