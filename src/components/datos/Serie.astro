---
/**
 * Evolución trimestral nacional: dos gráficos pequeños con un solo eje cada uno (nunca doble
 * eje): barras con el n de respuestas y puntos con IC95 del % con indicadores. Los trimestres
 * suprimidos se marcan con trama y sin altura (no se insinúa su valor). Tabla equivalente debajo.
 */
import type { CeldaTrim } from "@/lib/publico/datos";
import { fmtIc, fmtPct, textoN } from "@/lib/publico/vista";

interface Props {
  serie: CeldaTrim[];
  anio: number;
}
const { serie, anio } = Astro.props;
const porTrim = new Map(serie.map((t) => [t.trimestre, t]));
const trimestres = [1, 2, 3, 4].map((q) => ({ q, celda: porTrim.get(q) }));

const ANCHO = 340;
const ALTO = 190;
const M = { izq: 40, der: 10, sup: 22, inf: 30 };
const anchoUtil = ANCHO - M.izq - M.der;
const altoUtil = ALTO - M.sup - M.inf;
const paso = anchoUtil / 4;
const xCentro = (q: number) => M.izq + paso * (q - 0.5);

function maximoRedondo(v: number): number {
  if (v <= 0) return 1;
  const exp = 10 ** Math.floor(Math.log10(v));
  for (const m of [1, 2, 2.5, 5, 10]) if (m * exp >= v) return m * exp;
  return 10 * exp;
}

// Barras de n.
const maxN = maximoRedondo(Math.max(5, ...serie.map((t) => t.n ?? 0)));
const yN = (v: number) => M.sup + altoUtil - (v / maxN) * altoUtil;
const ticksN = [0, maxN / 2, maxN];
const anchoBarra = Math.min(44, paso * 0.55);
function barra(x: number, y: number, w: number, h: number, r = 4): string {
  const rr = Math.min(r, h, w / 2);
  const base = y + h;
  return `M${x},${base}V${y + rr}Q${x},${y} ${x + rr},${y}H${x + w - rr}Q${x + w},${y} ${x + w},${y + rr}V${base}Z`;
}

// Puntos de %.
const maxPct = Math.min(
  100,
  Math.max(30, Math.ceil(Math.max(0, ...serie.map((t) => t.ic95?.[1] ?? 0)) / 10) * 10),
);
const yP = (v: number) => M.sup + altoUtil - (v / maxPct) * altoUtil;
const ticksP = [0, maxPct / 2, maxPct];
const tramos: string[] = [];
let actual: string[] = [];
for (const { q, celda } of trimestres) {
  if (celda && !celda.suprimido && celda.pctIndicadores !== null) {
    actual.push(`${xCentro(q)},${yP(celda.pctIndicadores)}`);
  } else {
    if (actual.length > 1) tramos.push(`M${actual.join("L")}`);
    actual = [];
  }
}
if (actual.length > 1) tramos.push(`M${actual.join("L")}`);

const fmt = new Intl.NumberFormat("es-HN", { maximumFractionDigits: 0 });
const etiqueta = (q: number) => `T${q}`;
function titulo(q: number, c: CeldaTrim | undefined): string {
  if (!c) return `Trimestre ${q} de ${anio}: sin respuestas`;
  if (c.suprimido)
    return `Trimestre ${q} de ${anio}: menos de 5 respuestas o dato protegido (suprimido)`;
  return `Trimestre ${q} de ${anio}: ${textoN(c)} respuestas, ${fmtPct(c.pctIndicadores)} con indicadores (IC95 ${fmtIc(c.ic95)})`;
}
---

<div class="serie">
  <figure class="serie__grafico">
    <figcaption>Respuestas por trimestre</figcaption>
    <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} role="img" aria-labelledby="serie-n-t">
      <title id="serie-n-t">Respuestas por trimestre de {anio}. Detalle en la tabla de abajo.</title>
      {
        ticksN.map((t) => (
          <g>
            <line class="serie__rejilla" x1={M.izq} x2={ANCHO - M.der} y1={yN(t)} y2={yN(t)} />
            <text class="serie__eje" x={M.izq - 6} y={yN(t) + 4} text-anchor="end">{fmt.format(t)}</text>
          </g>
        ))
      }
      {
        trimestres.map(({ q, celda }) => {
          const x = xCentro(q) - anchoBarra / 2;
          return (
            <g>
              <title>{titulo(q, celda)}</title>
              <rect class="serie__blanco" x={xCentro(q) - paso / 2} y={M.sup} width={paso} height={altoUtil} />
              {celda && !celda.suprimido && celda.n !== null ? (
                <>
                  <path class="serie__barra" d={barra(x, yN(celda.n), anchoBarra, yN(0) - yN(celda.n))} />
                  <text class="serie__valor" x={xCentro(q)} y={yN(celda.n) - 6} text-anchor="middle">{fmt.format(celda.n)}</text>
                </>
              ) : celda ? (
                <>
                  <rect class="serie__suprimido" x={x} y={yN(0) - 8} width={anchoBarra} height="8" rx="2" />
                  <text class="serie__valor serie__valor--suave" x={xCentro(q)} y={yN(0) - 14} text-anchor="middle">{"< 5*"}</text>
                </>
              ) : (
                <text class="serie__valor serie__valor--suave" x={xCentro(q)} y={yN(0) - 6} text-anchor="middle">—</text>
              )}
              <text class="serie__eje" x={xCentro(q)} y={ALTO - 10} text-anchor="middle">{etiqueta(q)}</text>
            </g>
          );
        })
      }
      <line class="serie__base" x1={M.izq} x2={ANCHO - M.der} y1={yN(0)} y2={yN(0)} />
    </svg>
  </figure>

  <figure class="serie__grafico">
    <figcaption>% con indicadores por trimestre (con IC95)</figcaption>
    <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} role="img" aria-labelledby="serie-p-t">
      <title id="serie-p-t">Porcentaje con indicadores por trimestre de {anio}, con intervalo de confianza. Detalle en la tabla de abajo.</title>
      {
        ticksP.map((t) => (
          <g>
            <line class="serie__rejilla" x1={M.izq} x2={ANCHO - M.der} y1={yP(t)} y2={yP(t)} />
            <text class="serie__eje" x={M.izq - 6} y={yP(t) + 4} text-anchor="end">{fmt.format(t)} %</text>
          </g>
        ))
      }
      {tramos.map((d) => <path class="serie__linea" d={d} />)}
      {
        trimestres.map(({ q, celda }) => (
          <g>
            <title>{titulo(q, celda)}</title>
            <rect class="serie__blanco" x={xCentro(q) - paso / 2} y={M.sup} width={paso} height={altoUtil} />
            {celda && !celda.suprimido && celda.pctIndicadores !== null && celda.ic95 ? (
              <>
                <line class="serie__ic" x1={xCentro(q)} x2={xCentro(q)} y1={yP(celda.ic95[0])} y2={yP(celda.ic95[1])} />
                <line class="serie__ic" x1={xCentro(q) - 5} x2={xCentro(q) + 5} y1={yP(celda.ic95[0])} y2={yP(celda.ic95[0])} />
                <line class="serie__ic" x1={xCentro(q) - 5} x2={xCentro(q) + 5} y1={yP(celda.ic95[1])} y2={yP(celda.ic95[1])} />
                <circle class="serie__punto" cx={xCentro(q)} cy={yP(celda.pctIndicadores)} r="5" />
              </>
            ) : (
              <text class="serie__valor serie__valor--suave" x={xCentro(q)} y={yP(0) - 6} text-anchor="middle">{celda ? "< 5*" : "—"}</text>
            )}
            <text class="serie__eje" x={xCentro(q)} y={ALTO - 10} text-anchor="middle">{etiqueta(q)}</text>
          </g>
        ))
      }
      <line class="serie__base" x1={M.izq} x2={ANCHO - M.der} y1={yP(0)} y2={yP(0)} />
    </svg>
  </figure>
</div>
<p class="serie__nota">
  &lt; 5* = trimestre suprimido: tiene menos de 5 respuestas, o se oculta para que no pueda
  deducirse otro trimestre pequeño restando del total anual. «—» = sin respuestas.
</p>

<div class="tabla-envoltura" role="region" aria-label={`Tabla de la serie trimestral ${anio}`} tabindex="0">
  <table class="tabla-datos">
    <caption class="visualmente-oculto">Serie trimestral nacional {anio}</caption>
    <thead>
      <tr>
        <th scope="col">Trimestre</th>
        <th scope="col" class="num">Respuestas</th>
        <th scope="col" class="num">% con indicadores</th>
        <th scope="col" class="num">IC95</th>
      </tr>
    </thead>
    <tbody>
      {
        trimestres.map(({ q, celda }) => (
          <tr>
            <th scope="row">Trimestre {q}</th>
            <td class="num">{textoN(celda)}</td>
            <td class="num">{celda && !celda.suprimido ? fmtPct(celda.pctIndicadores) : "—"}</td>
            <td class="num">{celda && !celda.suprimido ? fmtIc(celda.ic95) : "—"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .serie {
    display: grid;
    gap: var(--espacio-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .serie {
      grid-template-columns: 1fr 1fr;
    }
  }
  .serie__grafico {
    margin: 0;
  }
  .serie__grafico figcaption {
    font-weight: 700;
    margin-bottom: var(--espacio-2);
  }
  .serie svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .serie__rejilla {
    stroke: var(--dv-rejilla);
    stroke-width: 1;
  }
  .serie__base {
    stroke: var(--dv-eje);
    stroke-width: 1.5;
  }
  .serie__eje {
    fill: var(--color-texto-suave);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .serie__valor {
    fill: var(--color-texto);
    font-size: 12.5px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .serie__valor--suave {
    fill: var(--color-texto-suave);
    font-weight: 600;
  }
  .serie__barra {
    fill: var(--dv-n-2);
  }
  .serie__suprimido {
    fill: url(#mapa-datos-trama);
    stroke: var(--dv-trama);
    stroke-width: 1;
  }
  .serie__linea {
    fill: none;
    stroke: var(--dv-pct-4);
    stroke-width: 2;
  }
  .serie__ic {
    stroke: var(--dv-pct-3);
    stroke-width: 2;
  }
  .serie__punto {
    fill: var(--dv-pct-4);
    stroke: var(--color-fondo);
    stroke-width: 2;
  }
  .serie__blanco {
    fill: transparent;
  }
  .serie g:hover .serie__barra,
  .serie g:hover .serie__punto {
    filter: brightness(1.12);
  }
  .serie__nota {
    font-size: 0.9rem;
    color: var(--color-texto-suave);
    margin-top: var(--espacio-2);
  }
</style>
