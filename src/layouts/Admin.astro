---
import "@/styles/global.css";
import Filtros from "@/components/admin/Filtros.astro";
import type { Usuario } from "@/lib/admin/proteger";
import { modoAdmin } from "@/lib/admin/proteger";
import type { Filtros as TipoFiltros } from "@/lib/reportes/filtros";
import { etiquetaPeriodo } from "@/lib/reportes/filtros";

interface Props {
  titulo: string;
  usuario?: Usuario | null;
  filtros?: TipoFiltros;
  /** Oculta la barra de filtros (p. ej. en /admin/sistema). */
  sinFiltros?: boolean;
  activo?: string;
}

const { titulo, usuario = null, filtros, sinFiltros = false, activo = "" } = Astro.props;
const seccion = activo || Astro.url.pathname.replace(/^\/admin\/?/, "").split("/")[0] || "resumen";
const modoPassword = modoAdmin() === "password";

const NAV: Array<{ id: string; ruta: string; etiqueta: string }> = [
  { id: "resumen", ruta: "/admin", etiqueta: "Resumen" },
  { id: "volumen", ruta: "/admin/volumen", etiqueta: "Volumen" },
  { id: "geografia", ruta: "/admin/geografia", etiqueta: "Geografía" },
  { id: "demografia", ruta: "/admin/demografia", etiqueta: "Demografía" },
  { id: "puntajes", ruta: "/admin/puntajes", etiqueta: "Puntajes" },
  { id: "comorbilidad", ruta: "/admin/comorbilidad", etiqueta: "Comorbilidad" },
  { id: "desempeno", ruta: "/admin/desempeno", etiqueta: "Desempeño" },
  { id: "psicometria", ruta: "/admin/psicometria", etiqueta: "Psicometría" },
  { id: "calidad", ruta: "/admin/calidad", etiqueta: "Calidad de datos" },
  { id: "investigacion", ruta: "/admin/investigacion", etiqueta: "Investigación" },
  { id: "historico", ruta: "/admin/historico", etiqueta: "Histórico" },
  { id: "exportar", ruta: "/admin/exportar", etiqueta: "Exportar" },
  { id: "sistema", ruta: "/admin/sistema", etiqueta: "Sistema" },
];
const consulta = Astro.url.search;
---

<!doctype html>
<html lang="es-HN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Panel Atento</title>
    <link rel="icon" href="/marca/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin">
    <a class="salto-contenido" href="#contenido">Ir al contenido</a>
    <div class="admin__marco">
      <aside class="admin__lateral">
        <a class="admin__marca" href="/admin">
          <img src="/marca/simbolo.svg" alt="" width="28" height="28" />
          <span>Atento · Panel</span>
        </a>
        <nav aria-label="Secciones del panel">
          <ul class="admin__nav">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={`${item.ruta}${item.id === "sistema" || item.id === "exportar" ? "" : consulta}`}
                    aria-current={seccion === item.id ? "page" : undefined}
                  >
                    {item.etiqueta}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          usuario && (
            <div class="admin__usuario">
              <p>
                <strong>{usuario.email}</strong>
                <br />
                <span class="admin__rol">rol: {usuario.rol}</span>
              </p>
              {modoPassword && (
                <form method="post" action="/admin/salir">
                  <button type="submit" class="boton boton--secundario">Salir</button>
                </form>
              )}
            </div>
          )
        }
        <p class="admin__nota">Cribado comunitario, no diagnóstico. Celdas con n &lt; 5 suprimidas.</p>
      </aside>
      <div class="admin__principal">
        <header class="admin__cabecera">
          <h1>{titulo}</h1>
          {filtros && <p class="admin__periodo">{etiquetaPeriodo(filtros.periodo)}{filtros.comparar ? ` · comparado con ${etiquetaPeriodo(filtros.comparar).toLowerCase()}` : ""}</p>}
        </header>
        {filtros && !sinFiltros && <Filtros filtros={filtros} />}
        <main id="contenido" class="admin__contenido">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Tokens del panel: cromo del sitio (global.css) + paleta de datos validada (skill dataviz). */
  .admin {
    --viz-serie-1: #2a78d6;
    --viz-serie-2: #eb6834;
    --viz-serie-3: #1baf7a;
    --viz-sec-1: #b7d3f6;
    --viz-sec-2: #6da7ec;
    --viz-sec-3: #2a78d6;
    --viz-sec-4: #1c5cab;
    --viz-sec-5: #0d366b;
    --viz-vacio: #ececea;
    --viz-trama: #898781;
    --viz-rejilla: #e1e0d9;
    --viz-eje: #c3c2b7;
    --viz-ink-suave: #898781;
    --viz-bueno: #006300;
    --viz-critico: #d03b3b;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .admin {
      --viz-serie-1: #3987e5;
      --viz-serie-2: #d95926;
      --viz-serie-3: #199e70;
      --viz-sec-1: #184f95;
      --viz-sec-2: #256abf;
      --viz-sec-3: #3987e5;
      --viz-sec-4: #6da7ec;
      --viz-sec-5: #b7d3f6;
      --viz-vacio: #2c2c2a;
      --viz-trama: #898781;
      --viz-rejilla: #2c2c2a;
      --viz-eje: #383835;
      --viz-bueno: #0ca30c;
      --viz-critico: #e66767;
    }
  }
  :root[data-theme="dark"] .admin {
    --viz-serie-1: #3987e5;
    --viz-serie-2: #d95926;
    --viz-serie-3: #199e70;
    --viz-sec-1: #184f95;
    --viz-sec-2: #256abf;
    --viz-sec-3: #3987e5;
    --viz-sec-4: #6da7ec;
    --viz-sec-5: #b7d3f6;
    --viz-vacio: #2c2c2a;
    --viz-trama: #898781;
    --viz-rejilla: #2c2c2a;
    --viz-eje: #383835;
    --viz-bueno: #0ca30c;
    --viz-critico: #e66767;
  }

  .admin__marco {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    min-height: 100vh;
  }
  .admin__lateral {
    background: var(--color-superficie);
    border-right: 1px solid var(--color-borde);
    padding: var(--espacio-3);
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
  }
  .admin__marca {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
    font-weight: 700;
    color: var(--color-texto);
    text-decoration: none;
  }
  .admin__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .admin__nav a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radio);
    color: var(--color-texto);
    text-decoration: none;
  }
  .admin__nav a:hover {
    background: var(--color-fondo);
  }
  .admin__nav a[aria-current="page"] {
    background: var(--color-primario);
    color: var(--color-primario-contraste);
    font-weight: 600;
  }
  .admin__usuario {
    margin-top: auto;
    font-size: 0.85rem;
    word-break: break-all;
  }
  .admin__rol {
    color: var(--color-texto-suave);
  }
  .admin__nota {
    font-size: 0.8rem;
    color: var(--color-texto-suave);
    margin: 0;
  }
  .admin__principal {
    padding: var(--espacio-4);
    display: flex;
    flex-direction: column;
    gap: var(--espacio-3);
  }
  .admin__cabecera h1 {
    margin: 0;
    font-size: 1.5rem;
  }
  .admin__periodo {
    margin: var(--espacio-1) 0 0;
    color: var(--color-texto-suave);
  }
  .admin__contenido {
    max-width: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espacio-4);
  }
  .panel {
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    padding: var(--espacio-3);
  }
  .panel > h2:first-child {
    margin-top: 0;
    font-size: 1.1rem;
  }
  .panel__nota {
    color: var(--color-texto-suave);
    font-size: 0.85rem;
  }
  .rejilla {
    display: grid;
    gap: var(--espacio-3);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .rejilla > * {
    min-width: 0;
  }
  .rejilla--2 {
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
  }
  .boton {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radio);
    border: 1px solid var(--color-primario);
    background: var(--color-primario);
    color: var(--color-primario-contraste);
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }
  .boton--secundario {
    background: transparent;
    color: var(--color-primario);
  }
  .boton--peligro {
    background: transparent;
    border-color: var(--viz-critico);
    color: var(--viz-critico);
  }
  .aviso {
    border-left: 4px solid var(--color-acento);
    padding: var(--espacio-2) var(--espacio-3);
    background: var(--color-superficie);
  }
  .tabla-contenedor {
    overflow-x: auto;
  }
  .tabla {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }
  .tabla caption {
    text-align: left;
    font-weight: 600;
    padding-bottom: var(--espacio-2);
  }
  .tabla th,
  .tabla td {
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--color-borde);
    text-align: left;
    vertical-align: top;
  }
  .tabla th {
    color: var(--color-texto-suave);
    font-weight: 600;
  }
  .tabla td.num,
  .tabla th.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .tabla .suprimido {
    color: var(--color-texto-suave);
    font-style: italic;
  }
  .viz {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--fuente-base);
  }
  .viz text {
    fill: var(--color-texto);
    font-size: 12px;
  }
  .viz .viz__eje-etq {
    fill: var(--viz-ink-suave);
    font-size: 11px;
  }
  .viz .viz__rejilla {
    stroke: var(--viz-rejilla);
    stroke-width: 1;
  }
  .viz .viz__eje {
    stroke: var(--viz-eje);
    stroke-width: 1;
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2) var(--espacio-3);
    font-size: 0.85rem;
    margin: var(--espacio-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .leyenda__muestra {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 2px;
    vertical-align: -0.1rem;
    margin-right: 0.35rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  details.tabla-datos summary {
    cursor: pointer;
    color: var(--color-primario);
    font-size: 0.9rem;
  }
  @media (max-width: 56rem) {
    .admin__marco {
      grid-template-columns: 1fr;
    }
    .admin__lateral {
      border-right: 0;
      border-bottom: 1px solid var(--color-borde);
    }
    .admin__nav {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .admin__usuario {
      margin-top: 0;
    }
    .admin__principal {
      padding: var(--espacio-3);
    }
  }
</style>
