---
import Base from "@/layouts/Base.astro";

/** Plantilla para documentos largos (legal, metodología): índice lateral y fecha de versión. */
interface Encabezado {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  titulo: string;
  descripcion: string;
  version?: string;
  encabezados: Encabezado[];
  noindex?: boolean;
}

const { titulo, descripcion, version, encabezados, noindex = false } = Astro.props;
const indice = encabezados.filter((h) => h.depth === 2);
---

<Base titulo={titulo} descripcion={descripcion} noindex={noindex}>
  <article class="contenedor contenedor--ancho documento">
    <header class="documento__cabecera">
      <h1>{titulo}</h1>
      {version && <p class="documento__version">{version}</p>}
    </header>
    <div class="documento__cuerpo">
      {
        indice.length > 1 && (
          <nav class="indice" aria-labelledby="indice-titulo">
            {/* Abierto por defecto (sin JS); el script lo pliega en pantallas angostas. */}
            <details class="indice__plegable" open data-indice>
              <summary id="indice-titulo">En esta página</summary>
              {/* Lista sin números: los títulos ya traen su numeración. */}
              <ul>
                {indice.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-seccion={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </nav>
        )
      }
      <div class="prosa">
        <slot />
      </div>
    </div>
  </article>
  <script is:inline nonce={Astro.locals.nonce}>
    (() => {
      const plegable = document.querySelector("[data-indice]");
      if (!plegable) return;
      const ancho = window.matchMedia("(min-width: 56rem)");
      const ajustar = () => {
        plegable.open = ancho.matches;
      };
      ajustar();
      ancho.addEventListener("change", ajustar);

      // En móvil, al elegir una sección se cierra el índice.
      plegable.addEventListener("click", (e) => {
        if (e.target instanceof HTMLAnchorElement && !ancho.matches) plegable.open = false;
      });

      // Resalta la sección visible.
      const enlaces = new Map(
        [...plegable.querySelectorAll("a[data-seccion]")].map((a) => [a.dataset.seccion, a]),
      );
      const titulos = [...enlaces.keys()].map((id) => document.getElementById(id)).filter(Boolean);
      if (!("IntersectionObserver" in window) || titulos.length === 0) return;
      const marcar = (id) => {
        for (const [clave, a] of enlaces) {
          if (clave === id) a.setAttribute("aria-current", "location");
          else a.removeAttribute("aria-current");
        }
      };
      const observador = new IntersectionObserver(
        (entradas) => {
          const visible = entradas.filter((e) => e.isIntersecting)[0];
          if (visible) marcar(visible.target.id);
        },
        { rootMargin: "-15% 0px -70% 0px" },
      );
      for (const t of titulos) observador.observe(t);
    })();
  </script>
</Base>

<style>
  .documento {
    padding-block: var(--espacio-5);
  }
  .documento__cabecera {
    margin-bottom: var(--espacio-4);
    padding-bottom: var(--espacio-4);
    border-bottom: var(--borde-ancho) solid var(--color-borde);
  }
  .documento__version {
    margin: 0;
    color: var(--color-texto-suave);
    font-size: 0.95rem;
  }
  .documento__cuerpo {
    display: grid;
    gap: var(--espacio-4);
    align-items: start;
  }
  .indice {
    background: var(--color-superficie);
    border: var(--borde-ancho) solid var(--color-borde);
    border-radius: var(--radio-grande);
    padding: var(--espacio-2) var(--espacio-4);
  }
  .indice summary {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-texto-suave);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 2.75rem;
  }
  .indice summary::-webkit-details-marker {
    display: none;
  }
  .indice summary::after {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
  }
  .indice__plegable[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }
  .indice summary:focus-visible {
    outline: 3px solid var(--color-foco);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .indice a[aria-current] {
    color: var(--color-primario-fuerte);
    font-weight: 700;
    box-shadow: inset 3px 0 0 var(--color-primario);
    padding-left: 0.6rem;
    margin-left: -0.6rem;
  }
  .indice ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .indice li {
    margin: 0;
  }
  .indice a {
    display: block;
    padding: 0.4rem 0;
    line-height: 1.35;
    text-decoration: none;
    color: var(--color-texto);
  }
  .indice a:hover,
  .indice a:focus-visible {
    color: var(--color-primario-fuerte);
    text-decoration: underline;
  }
  .prosa :global(h2:first-child) {
    margin-top: 0;
  }
  .prosa :global(h2) {
    scroll-margin-top: 5rem;
  }
  @media (min-width: 56rem) {
    /* Índice angosto a la izquierda; el texto ocupa el resto. */
    .documento__cuerpo {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--espacio-6);
    }
    .indice {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      padding: var(--espacio-3);
    }
    .indice ul {
      font-size: 0.9rem;
    }
    /* En escritorio el índice siempre está abierto: el título no es un botón. */
    .indice summary {
      cursor: default;
      pointer-events: none;
      min-height: 0;
      margin-bottom: var(--espacio-2);
    }
    .indice summary::after {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .indice summary::after {
      transition: none;
    }
  }
</style>
